# Copy this file to .env and fill in your own values. NEVER commit .env.
# (.gitignore already excludes .env)

# OpenAI-compatible API for LLM-driven concept-variant generation
# Used by app.py's `_llm_generate_descriptions` when an unseen concept
# is requested via POST /compose.
API_KEY=sk-your-key-here
API_BASE_URL=https://api.example.com/v1

# Optional overrides (defaults shown)
# LLM_MODEL=gpt-5.4-2026-03-05
# LLM_NUM_VARIANTS=100
# LLM_TIMEOUT_S=120

# Optional: route HF downloads through a mirror
# HF_ENDPOINT=https://hf-mirror.com
